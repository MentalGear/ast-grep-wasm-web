{
  "name": "ag-wasm",
  "type": "module",
  "version": "0.3.0",
  "description": "ast-grep WASM - AST-based code searching, linting, and rewriting",
  "author": "LoTwT <l709937065@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/LoTwT/ag-wasm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoTwT/ag-wasm.git"
  },
  "bugs": {
    "url": "https://github.com/LoTwT/ag-wasm/issues"
  },
  "keywords": [
    "ast-grep",
    "ast-grep-wasm",
    "ag",
    "ag-wasm"
  ],
  "sideEffects": [
    "./dist/bundler/index.js",
    "./snippets/*"
  ],
  "exports": {
    ".": "./dist/web/index.js",
    "./node": {
      "types": "./dist/node/index.d.ts",
      "require": "./dist/node/index.cjs"
    },
    "./node-fs": {
      "types": "./dist/node-fs/index.d.ts",
      "import": "./dist/node-fs/index.js"
    },
    "./bundler": "./dist/bundler/index.js",
    "./*": [
      "./*",
      "./*.d.ts"
    ]
  },
  "main": "./dist/web/index.js",
  "module": "./dist/web/index.js",
  "types": "./dist/web/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "bin": {
    "sg": "./dist/cli/cli.js",
    "ast-grep": "./dist/cli/cli.js"
  },
  "files": [
    "dist",
    "parsers"
  ],
  "dependencies": {
    "web-tree-sitter": "^0.22.6",
    "web-tree-sitter-sg": "0.22.2",
    "yaml": "^2.7.1"
  }
}
